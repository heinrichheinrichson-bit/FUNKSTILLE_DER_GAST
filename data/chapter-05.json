    {
      "id": "k5_061_varga",
      "chapter": 5,
      "delaySeconds": 45,
      "messages": [
        { "speaker": "kader", "text": "Varga war verletzt. Er war auch der Einzige, der noch in den Schacht steigen wollte." },
        { "speaker": "kader", "text": "Ich habe beides für Mut gehalten." }
      ],
      "next": "k5_070_chamber",
      "nextDelaySeconds": 40
    },
    {
      "id": "k5_062_warning",
      "chapter": 5,
      "delaySeconds": 45,
      "messages": [
        { "speaker": "kader", "text": "Ich wollte vier Stunden. Nur vier. Für eine zweite Messung." },
        { "speaker": "mira", "text": "Vier Stunden waren genug, damit niemand mehr wusste, wem er trauen konnte." }
      ],
      "next": "k5_070_chamber",
      "nextDelaySeconds": 40
    },
    {
      "id": "k5_063_old",
      "chapter": 5,
      "delaySeconds": 45,
      "messages": [
        { "speaker": "kader", "text": "Eine Notunterkunft in einer Gletscherspalte. Elf Kilometer südöstlich." },
        { "speaker": "kader", "text": "Das Projekt ist älter als diese Station. Ich fand die Akte erst nach Vargas Unfall." }
      ],
      "next": "k5_070_chamber",
      "nextDelaySeconds": 40
    },
