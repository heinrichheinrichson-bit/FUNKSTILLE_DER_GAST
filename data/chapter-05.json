    {
      "id": "k5_051_cooperative",
      "chapter": 5,
      "delaySeconds": 240,
      "messages": [
        { "speaker": "mira", "text": "Kader sitzt vor der Kernkammer. Schutzanzug, Visier offen." },
        { "speaker": "kader", "text": "Ich habe den Bericht geändert. Wenn Sie eine Erklärung brauchen, bekommen Sie keine gute." },
        { "speaker": "kader", "text": "Wir hatten drei Monate, bevor das Projekt gestrichen worden wäre. Ich wollte Gewissheit." }
      ],
      "next": "k5_060_truth",
      "nextDelaySeconds": 30
    },
    {
      "id": "k5_052_independent",
      "chapter": 5,
      "delaySeconds": 240,
      "messages": [
        { "speaker": "mira", "text": "Kader arbeitet am Bohrkopf. Werkzeug und Probenbehälter liegen offen." },
        { "speaker": "kader", "text": "Sie hätten nicht kommen sollen. Jetzt helfen Sie oder gehen wieder." }
      ],
      "next": "k5_060_truth",
      "nextDelaySeconds": 30
    },
    {
      "id": "k5_053_changed",
      "chapter": 5,
      "delaySeconds": 240,
      "messages": [
        { "speaker": "mira", "text": "Kader steht mit der Stirn an der Sichtscheibe." },
        { "speaker": "kader", "text": "Es bildet keine Kolonie. Kolonie ist das falsche Wort." },
        { "speaker": "mira", "text": "Dann dreht er sich um und begrüßt mich, als wäre ich gerade erst angekommen." }
      ],
      "next": "k5_060_truth",
      "nextDelaySeconds": 30
    },
    {
      "id": "k5_060_truth",
      "chapter": 5,
      "delaySeconds": 30,
      "messages": [
        { "speaker": "kader", "text": "Ich dachte, wir beobachten Reaktion. In Wahrheit beobachtete es uns." },
        { "speaker": "kader", "text": "Das ist eine Metapher, Lindner. Schreiben Sie nicht, ich hätte Bewusstsein behauptet." }
      ],
      "choices": [
        {
          "id": "ask_varga",
          "label": "Konfrontiere ihn mit Varga.",
          "next": "k5_061_varga",
          "requires": [],
          "effects": []
        },
        {
          "id": "ask_warning",
          "label": "Frag nach Thals blockiertem Warnruf.",
          "next": "k5_062_warning",
