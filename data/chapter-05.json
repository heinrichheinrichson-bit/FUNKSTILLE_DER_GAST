    {
      "id": "k5_020_tower",
      "chapter": 5,
      "delaySeconds": 540,
      "messages": [
        { "speaker": "mira", "text": "Bohrturm erreicht. Eine Seitenwand ist nach außen gebogen. Nicht nach innen." },
        { "speaker": "mira", "text": "Als hätte der Druck im Gebäude gesessen." },
        { "speaker": "mira", "text": "Die Luft riecht süßlich. Ozon und etwas Organisches. Schutz bleibt zu." }
      ],
      "next": "k5_030_accident_log",
      "nextDelaySeconds": 60
    },
    {
      "id": "k5_030_accident_log",
      "chapter": 5,
      "delaySeconds": 120,
      "messages": [
        { "speaker": "mira", "text": "Unfallbericht: Emil Varga. Schnitt an der linken Hand beim Bergen von Kern 14C." },
        { "speaker": "mira", "text": "Desinfiziert, vier Stiche, zur Arbeit zurück. Am Folgetag war die Wunde vollständig geschlossen." },
        { "speaker": "mira", "text": "Dafür gibt es ein Foto. Nach zwölf Stunden." }
      ],
      "variants": [
        {
          "requires": [
            { "state": "patient_zero_clue", "operator": "eq", "value": true }
          ],
          "appendMessages": [
            { "speaker": "mira", "text": "Sein Ausweis lag draußen im Schnee. Vier Tage nach diesem Eintrag." }
          ]
        }
      ],
      "effects": [
        { "state": "patient_zero_confirmed", "operation": "set", "value": true },
        { "state": "evidence_level", "operation": "add", "value": 1 }
      ],
      "next": "k5_040_descent",
      "nextDelaySeconds": 40
    },
