    {
      "id": "k5_051_cooperative",
      "chapter": 5,
      "delaySeconds": 240,
      "messages": [
        {
          "speaker": "mira",
          "text": "Kader sitzt im Sicherheitsraum vor der Kernkammer. Schutzanzug geschlossen, Visier offen."
        },
        {
          "speaker": "mira",
          "text": "Er gibt zu, Thals Bericht geändert zu haben. Nicht stolz. Eher so, als hätte er den Satz seit Stunden vorbereitet."
        },
        {
          "speaker": "mira",
          "text": "Er sagt, das Projekt wäre nach drei Monaten ohne eindeutigen Befund beendet worden. Er wollte noch eine Messreihe – und hielt deshalb die Warnung zurück."
        },
        {
          "speaker": "mira",
          "text": "Ich habe ihm die Steuerung gesperrt. Er bleibt unter Beobachtung, bis wir entscheiden, ob wir ihn mitnehmen."
        }
      ],
      "next": "k5_060_truth",
      "nextDelaySeconds": 30,
      "location": {
        "area": "tower",
        "room": "platform",
        "stationLeft": 81,
        "stationTop": 58,
        "interiorLeft": 50,
        "interiorTop": 50,
        "activity": "Mira ist im Bohrturm"
      }
    },
    {
      "id": "k5_052_independent",
      "chapter": 5,
      "delaySeconds": 240,
      "messages": [
        {
          "speaker": "mira",
          "text": "Kader arbeitet allein am Bohrkopf. Werkzeug und Probenbehälter liegen offen."
        },
        {
          "speaker": "mira",
          "text": "Er fragt nicht, ob ich verletzt bin. Er sagt nur, die Kammer werde instabil und wir müssten entweder helfen oder den Bereich verlassen."
        },
        {
          "speaker": "mira",
          "text": "Ich bleibe hinter der markierten Sicherheitslinie, bis er erklärt, was er getan hat."
        }
      ],
      "next": "k5_060_truth",
      "nextDelaySeconds": 30,
      "location": {
        "area": "tower",
        "room": "platform",
        "stationLeft": 81,
        "stationTop": 58,
        "interiorLeft": 50,
        "interiorTop": 50,
        "activity": "Mira ist im Bohrturm"
      }
    },
    {
      "id": "k5_053_changed",
      "chapter": 5,
      "delaySeconds": 240,
      "messages": [
        {
          "speaker": "mira",
          "text": "Kader steht mit der Stirn an der Sichtscheibe. Sein Visier ist offen."
        },
        {
          "speaker": "mira",
          "text": "Er redet über die Strukturen in der Probe und verliert mitten im Satz den Faden."
        },
        {
          "speaker": "mira",
          "text": "Dann sieht er mich an und begrüßt mich ein zweites Mal, als hätte er die letzten zehn Sekunden nicht erlebt."
        }
      ],
      "next": "k5_060_truth",
      "nextDelaySeconds": 30,
      "location": {
        "area": "tower",
        "room": "platform",
        "stationLeft": 81,
        "stationTop": 58,
        "interiorLeft": 50,
        "interiorTop": 50,
        "activity": "Mira ist im Bohrturm"
      }
    },
    {
      "id": "k5_060_truth",
      "chapter": 5,
      "delaySeconds": 30,
      "messages": [
        {
          "speaker": "mira",
          "text": "Kader sagt, sie hätten zunächst nur eine Reaktion auf Wärme und Strom erwartet."
        },
        {
          "speaker": "mira",
          "text": "Dann begannen die Messmuster immer dann zu wechseln, wenn Menschen den Raum betraten."
        },
        {
          "speaker": "mira",
          "text": "Er warnt mich ausdrücklich davor, daraus Bewusstsein abzuleiten. Gleichzeitig kann er keine harmlose Erklärung mehr nennen."
        }
      ],
      "choices": [
        {
