    {
      "id": "k5_061_varga",
      "chapter": 5,
      "delaySeconds": 45,
      "messages": [
        {
          "speaker": "mira",
          "text": "Ich habe ihn mit Emils Krankenakte konfrontiert."
        },
        {
          "speaker": "mira",
          "text": "Kader sagt, Emil habe trotz Livs Arbeitsverbot darauf bestanden, noch einmal zum Schacht zu gehen. Kader ließ ihn, weil er dessen Entschlossenheit für Urteilsfähigkeit hielt."
        },
        {
          "speaker": "mira",
          "text": "Jetzt kann er mir nicht sagen, wann er Emil zuletzt zweifelsfrei gesehen hat."
        }
      ],
      "next": "k5_070_chamber",
      "nextDelaySeconds": 40,
      "location": {
        "area": "tower",
        "room": "platform",
        "stationLeft": 81,
        "stationTop": 58,
        "interiorLeft": 50,
        "interiorTop": 50,
        "activity": "Mira ist im Bohrturm"
      }
    },
    {
      "id": "k5_062_warning",
      "chapter": 5,
      "delaySeconds": 45,
      "messages": [
        {
          "speaker": "mira",
          "text": "Kader wollte Thals Warnung um vier Stunden verzögern, um die Messreihe abzuschließen."
        },
        {
          "speaker": "mira",
          "text": "In diesen vier Stunden fielen der Uplink und Teile des Stationsnetzes aus. Danach fehlten mehreren Menschen Erinnerungen."
        },
        {
          "speaker": "mira",
          "text": "Er nennt es eine Fehlentscheidung. Ingrid würde ein anderes Wort verwenden."
        }
      ],
      "next": "k5_070_chamber",
      "nextDelaySeconds": 40,
      "location": {
        "area": "tower",
        "room": "platform",
        "stationLeft": 81,
        "stationTop": 58,
        "interiorLeft": 50,
