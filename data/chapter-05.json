    {
      "id": "k5_040_descent",
      "chapter": 5,
      "delaySeconds": 40,
      "messages": [
        {
          "speaker": "mira",
          "text": "Der Lift hat keinen Strom. Bis Ebene minus drei führt nur die Wartungsleiter."
        },
        {
          "speaker": "mira",
          "text": "Kader meldet sich über die Gegensprechanlage. Er will, dass ich allein herunterkomme."
        },
        {
          "speaker": "mira",
          "text": "Nach allem, was wir wissen, ist das keine Anweisung, der ich blind folgen werde."
        }
      ],
