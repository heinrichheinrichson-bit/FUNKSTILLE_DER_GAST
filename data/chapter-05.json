    {
      "id": "k5_030_accident_log",
      "chapter": 5,
      "delaySeconds": 120,
      "messages": [
        {
          "speaker": "mira",
          "text": "Am Eingang hängt das digitale Unfallbuch. Letzter Eintrag: Emil Varga, Schnitt an der linken Hand beim Bergen von Kern 14C."
        },
        {
          "speaker": "mira",
          "text": "Liv hat die Wunde desinfiziert und mit vier Stichen versorgt. Zwölf Stunden später fotografierte sie eine vollständig geschlossene Hautoberfläche."
        },
        {
          "speaker": "mira",
          "text": "Darunter steht: „Heilungsverlauf medizinisch nicht erklärbar. Weitere Arbeit untersagt.“ Jemand hat die Sperre am nächsten Morgen aufgehoben."
        }
      ],
      "variants": [
        {
          "requires": [
            {
              "state": "patient_zero_clue",
              "operator": "eq",
              "value": true
            }
          ],
          "appendMessages": [
            {
              "speaker": "mira",
              "text": "Sein Ausweis lag draußen im Schnee. Vier Tage nach diesem Eintrag."
            }
          ]
        }
      ],
      "effects": [
        {
