        "activity": "Mira ist im Bohrturm"
      }
    },
    {
      "id": "k5_063_old",
      "chapter": 5,
      "delaySeconds": 45,
      "messages": [
        {
          "speaker": "mira",
          "text": "Kader hat in den Projektdaten Koordinaten einer alten Notunterkunft gefunden, elf Kilometer südöstlich von Kaldstad."
        },
        {
          "speaker": "mira",
          "text": "Dort wurde Jahre vor dieser Station mit Material aus derselben Eisschicht gearbeitet."
        },
        {
          "speaker": "mira",
          "text": "Er behauptet, die Akte erst nach Emils Unfall gefunden zu haben. Im Moment kann ich das weder beweisen noch widerlegen."
        }
      ],
      "next": "k5_070_chamber",
      "nextDelaySeconds": 40,
      "location": {
        "area": "tower",
