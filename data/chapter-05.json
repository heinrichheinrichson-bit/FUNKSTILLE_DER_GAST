        { "speaker": "mira", "text": "Auf der Oberfläche liegt etwas wie Reif. Es bildet Linien gegen die Schwerkraft." },
        { "speaker": "kader", "text": "Wir können schließen, nehmen, was wir brauchen, oder tiefer gehen." }
      ],
      "choices": [
        {
          "id": "seal_with_material",
          "label": "Versiegle den Riss.",
