    {
      "id": "k5_020_tower",
      "chapter": 5,
      "delaySeconds": 540,
      "messages": [
        {
          "speaker": "mira",
          "text": "Bohrturm erreicht. Die untere Seitenwand ist nach außen gewölbt."
        },
        {
          "speaker": "mira",
          "text": "Das spricht für einen Druckstoß im Inneren. Nicht für etwas, das von draußen eingedrungen ist."
        },
        {
          "speaker": "mira",
          "text": "Der Luftsensor meldet Lösungsmitteldämpfe und Ozon. Visier bleibt geschlossen."
        }
      ],
      "next": "k5_030_accident_log",
      "nextDelaySeconds": 60,
