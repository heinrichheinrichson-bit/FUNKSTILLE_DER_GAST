          "speaker": "system",
          "text": "[SIGNAL UNTERBROCHEN]"
        },
        {
          "speaker": "system",
          "text": "Das Relais versucht elfmal, die Verbindung neu aufzubauen."
        },
        {
          "speaker": "system",
          "text": "Kein Versuch erreicht Kaldstad."
        },
        {
          "speaker": "system",
          "text": "Ob der Rettungsflug die Station gefunden hat, erfährst du nicht. Funkstille."
        }
      ],
