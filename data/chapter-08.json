    {
      "id": "k8_030_wait",
      "chapter": 8,
      "delaySeconds": 600,
      "messages": [
        {
          "speaker": "mira",
          "text": "Erster Mast. Alle noch da."
        },
        {
          "speaker": "mira",
          "text": "Aksel trägt die Probenkiste. Ingrid hat das Richtfunkgerät. Kader geht zwischen uns."
        },
        {
          "speaker": "mira",
          "text": "Noch etwa dreißig Minuten bis zum Anflug."
        }
      ],
      "variants": [
        {
          "requires": [
            {
              "state": "generator_state",
              "operator": "eq",
              "value": "unstable"
            }
          ],
          "appendMessages": [
            {
              "speaker": "mira",
              "text": "Das Licht der Station ist endgültig ausgefallen."
