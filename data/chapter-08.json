              "operator": "eq",
              "value": false
            }
          ],
          "appendMessages": [
            {
              "speaker": "mira",
              "text": "Aksel hat aufgehört zu zittern. Bei dieser Kälte sollte das keine gute Nachricht sein."
            }
          ]
        },
        {
          "requires": [
            {
              "state": "evac_thal",
              "operator": "eq",
              "value": true
            }
          ],
          "appendMessages": [
            {
              "speaker": "mira",
              "text": "Ingrid sagt: „Ich habe Ihren Bericht geprüft. Nichts daran ist genug. Aber es muss reichen.“"
            }
          ]
        }
      ],
