        },
        {
          "speaker": "system",
          "text": "Im Abschlussbericht steht, für die anderen habe keine Behandlungsmöglichkeit bestanden."
        },
        {
          "speaker": "system",
          "text": "Das ist technisch korrekt."
        },
        {
          "speaker": "system",
          "text": "Sie schreibt dir nie wieder."
        }
      ],
