      "id": "k8_020_receipt",
      "chapter": 8,
      "delaySeconds": 60,
      "messages": [
        {
          "speaker": "mira",
          "text": "Quittung."
        },
        {
          "speaker": "system",
          "text": "RETTUNGSFLUG GESTARTET. ANKUNFT 43 MINUTEN. LANDEZONE NORD MARKIEREN."
        },
        {
          "speaker": "mira",
          "text": "Sie kommen. Wirklich."
        },
        {
          "speaker": "mira",
          "text": "Wir packen jetzt Probe, Beweise und Wärmezeug auf den Lastschlitten. Danach gehen wir gemeinsam zur Landezone."
        },
        {
          "speaker": "mira",
          "text": "Ich schreibe an jedem Leinenmast. Dazwischen brauche ich beide Hände."
        }
      ],
      "variants": [
        {
          "requires": [
            {
              "state": "niko_found",
              "operator": "eq",
              "value": true
            }
          ],
          "appendMessages": [
            {
              "speaker": "mira",
              "text": "Nikos Box wird warm eingepackt und auf dem Schlitten festgezurrt."
            }
          ]
        }
      ],
