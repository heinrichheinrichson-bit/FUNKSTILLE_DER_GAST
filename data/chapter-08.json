        },
        {
          "speaker": "system",
          "text": "Die Temperatur im Kernbereich fällt innerhalb einer Stunde unter den messbaren Bereich."
        },
        {
          "speaker": "system",
          "text": "Von Mira kommt keine weitere Nachricht."
        },
        {
          "speaker": "system",
          "text": "Sie hat verhindert, dass der Gast abreist."
        }
