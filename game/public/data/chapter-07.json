    {
      "id": "k7_090_departure",
      "chapter": 7,
      "delaySeconds": 120,
      "messages": [
        {
          "speaker": "mira",
          "text": "Das Manifest ist bestätigt. Die Station ist für den Abmarsch vorbereitet."
        },
        {
          "speaker": "mira",
          "text": "Wir gehen gemeinsam zur nördlichen Landezone. Ich melde mich an jedem Leinenmast; dazwischen brauche ich beide Hände."
        }
      ],
      "variants": [
        {
          "requires": [
            {
              "state": "evac_aksel",
              "operator": "eq",
              "value": true
            }
          ],
          "appendMessages": [
            {
              "speaker": "mira",
              "text": "Aksel kommt mit."
            }
          ]
        },
        {
          "requires": [
            {
              "state": "evac_thal",
              "operator": "eq",
              "value": true
            }
          ],
          "appendMessages": [
            {
              "speaker": "mira",
              "text": "Thal trägt den Beweisbehälter."
            }
          ]
        },
        {
          "requires": [
            {
              "state": "evac_kader",
              "operator": "eq",
              "value": true
            }
          ],
          "appendMessages": [
            {
              "speaker": "mira",
              "text": "Kader folgt mit Abstand."
            }
          ]
        },
        {
          "requires": [
            {
              "state": "niko_found",
              "operator": "eq",
              "value": true
            }
          ],
          "appendMessages": [
            {
              "speaker": "mira",
              "text": "Niko ist in der gepolsterten Box auf dem Lastschlitten. Er beschwert sich ohne Pause."
            }
          ]
        },
        {
          "requires": [
            {
              "state": "niko_found",
              "operator": "eq",
              "value": false
            }
          ],
          "appendMessages": [
            {
              "speaker": "mira",
              "text": "Im Vorratsraum ist es wieder still. Wir können das Wetterfenster nicht länger halten."
            }
          ]
        }
      ],
