        }
      ]
    },
    {
      "id": "k7_061_report_sent",
      "chapter": 7,
      "delaySeconds": 120,
      "messages": [
        { "speaker": "mira", "text": "Bericht vorbereitet. Wetterdaten und Koordinaten angehängt." }
