    {
      "id": "k7_010_synthesis",
      "chapter": 7,
      "delaySeconds": 720,
      "messages": [
        {
          "speaker": "mira",
          "text": "Der Hemmstoffansatz ist fertig."
        },
        {
          "speaker": "mira",
          "text": "Ein Gegenmittel ist es nicht. In den Zellkulturen stoppt er die Ausbildung der netzartigen Strukturen für mehrere Stunden."
        },
        {
          "speaker": "mira",
          "text": "Er wurde nie an Menschen getestet. Nutzen und Nebenwirkungen sind unbekannt."
        }
      ],
      "variants": [
        {
          "requires": [
            {
              "state": "doses_available",
              "operator": "eq",
              "value": 0
            }
          ],
          "appendMessages": [
            {
              "speaker": "mira",
              "text": "Wir haben keine verwendbare Dosis. Nur Rettung und Eindämmung bleiben."
            }
          ]
        },
        {
          "requires": [
            {
              "state": "doses_available",
              "operator": "eq",
              "value": 1
            }
          ],
          "appendMessages": [
            {
              "speaker": "mira",
              "text": "Eine Dosis. Nicht genug für alle."
            }
          ]
        },
        {
          "requires": [
            {
              "state": "doses_available",
              "operator": "eq",
              "value": 2
            }
          ],
          "appendMessages": [
            {
              "speaker": "mira",
              "text": "Zwei Dosen. Nicht genug für alle erreichbaren Personen."
            }
          ]
        },
        {
          "requires": [
            {
              "state": "doses_available",
              "operator": "eq",
              "value": 3
            }
          ],
          "appendMessages": [
            {
              "speaker": "mira",
              "text": "Drei Dosen. Mehr lässt der Ansatz nicht zu."
            }
          ]
        }
      ],
      "next": "k7_020_candidates",
