    {
      "id": "k7_005_reunion",
      "chapter": 7,
      "delaySeconds": 30,
      "messages": [
        {
          "speaker": "mira",
          "text": "Ich bin im Labor. Bevor wir über den Hemmstoff entscheiden, sage ich dir genau, wer wirklich hier ist und wie die Person hergekommen ist."
        }
      ],
      "variants": [
        {
          "requires": [
            {
              "state": "aksel_inside_after_return",
              "operator": "eq",
              "value": true
            }
          ],
          "appendMessages": [
            {
              "speaker": "mira",
              "text": "Aksel sitzt an der Wand neben der Dekonschleuse. Ich habe ihn selbst aus dem Wohntrakt hergebracht."
            }
          ]
        },
        {
          "requires": [
            {
              "state": "thal_returning",
              "operator": "eq",
              "value": true
            }
          ],
          "appendMessages": [
            {
              "speaker": "mira",
              "text": "Ingrid ist langsam vom Wohntrakt herübergekommen. Sie ruht im Laborvorraum."
            }
          ]
        },
        {
          "requires": [
            {
              "state": "kader_escorted_to_lab",
              "operator": "eq",
              "value": true
            }
          ],
          "appendMessages": [
            {
              "speaker": "mira",
              "text": "Kader wurde von Aksel und mir vom Bohrturm eskortiert. Er bleibt von der Steuerung getrennt."
            }
          ]
        },
        {
          "requires": [
            {
              "state": "niko_found",
              "operator": "eq",
              "value": true
            }
          ],
          "appendMessages": [
            {
              "speaker": "mira",
              "text": "Niko ist in seiner Transportbox im warmen Vorraum. Er bekommt selbstverständlich keinen menschlichen Hemmstoff."
            }
          ]
        }
      ],
      "next": "k7_010_synthesis",
      "nextDelaySeconds": 20,
      "location": {
