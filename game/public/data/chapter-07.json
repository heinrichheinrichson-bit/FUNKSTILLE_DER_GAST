    {
      "id": "k7_040_mira",
      "chapter": 7,
      "delaySeconds": 90,
      "messages": [
        { "speaker": "mira", "text": "Injektion gesetzt. Brennt entlang des Arms." },
        { "speaker": "mira", "text": "Für einen Moment war das Relais vollkommen still." },
        { "speaker": "mira", "text": "Wahrscheinlich Zufall." }
      ],
      "next": "k7_030_distribution_gate",
      "nextDelaySeconds": 30
    },
    {
      "id": "k7_041_aksel",
      "chapter": 7,
      "delaySeconds": 90,
      "messages": [
        { "speaker": "aksel", "text": "Wirst du mir danach glauben?" },
        { "speaker": "mira", "text": "Ich kann ihm nicht antworten. Er hält trotzdem den Arm hin." }
      ],
      "variants": [
        {
          "requires": [
            { "state": "trust_aksel", "operator": "lt", "value": 0 }
          ],
          "replaceMessages": [
            { "speaker": "mira", "text": "Aksel will die Spritze nicht." },
            { "speaker": "mira", "text": "Ich lese ihm Vargas Bericht vor. Danach hält er den Arm hin, ohne mich anzusehen." }
          ]
        }
      ],
      "next": "k7_030_distribution_gate",
      "nextDelaySeconds": 30
    },
    {
      "id": "k7_042_thal",
      "chapter": 7,
      "delaySeconds": 90,
      "messages": [
        { "speaker": "mira", "text": "Thal liest die gesamte Formel, bevor sie zustimmt." },
        { "speaker": "thal", "text": "Falls ich danach nicht mehr ich bin, woran merken Sie den Unterschied?" }
      ],
      "next": "k7_030_distribution_gate",
      "nextDelaySeconds": 30
    },
    {
      "id": "k7_043_kader",
      "chapter": 7,
      "delaySeconds": 90,
      "messages": [
        { "speaker": "kader", "text": "Sie geben dem Verantwortlichen die Dosis." },
        { "speaker": "mira", "text": "Er lacht einmal. Dann hält er den Arm hin." }
      ],
      "next": "k7_030_distribution_gate",
      "nextDelaySeconds": 30
    },
    {
      "id": "k7_044_preserved",
      "chapter": 7,
      "delaySeconds": 60,
      "messages": [
        { "speaker": "mira", "text": "Behälter versiegelt. Genug für ein externes Labor." },
        { "speaker": "mira", "text": "Oder für die nächste Katastrophe." }
      ],
      "next": "k7_030_distribution_gate",
      "nextDelaySeconds": 30
    },
    {
      "id": "k7_050_distribution_done",
      "chapter": 7,
      "delaySeconds": 30,
      "messages": [
        { "speaker": "mira", "text": "Wenn wir falschliegen, haben wir einen Gesunden mit etwas behandelt, das nie an Menschen getestet wurde." },
        { "speaker": "mira", "text": "Wenn wir gar nichts tun, nehmen wir vielleicht etwas Lebendes mit in den Hubschrauber." },
        { "speaker": "mira", "text": "Die Verteilung steht." }
      ],
      "next": "k7_060_report",
      "nextDelaySeconds": 60
    },
    {
