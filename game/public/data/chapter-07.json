    {
      "id": "k7_020_candidates",
      "chapter": 7,
      "delaySeconds": 60,
      "messages": [
        {
          "speaker": "mira",
          "text": "Ich behandle niemanden nach Gefühl oder nach einer Namensliste. Nur Menschen, die tatsächlich hier sind und deren Befunde wir vergleichen können."
        },
        {
          "speaker": "mira",
          "text": "Bei mir sprechen Erinnerungslücke und mögliche Exposition für ein Risiko. Kopfverletzung, Kälte und Erschöpfung erklären dieselben Symptome aber ebenfalls."
        },
        {
          "speaker": "mira",
          "text": "Es gibt keine sichere Diagnose. Jede Dosisentscheidung bleibt eine Abwägung."
        }
      ],
      "next": "k7_030_distribution_gate",
      "nextDelaySeconds": 30,
      "variants": [
        {
          "requires": [
            {
              "state": "aksel_inside_after_return",
              "operator": "eq",
              "value": true
            }
          ],
          "appendMessages": [
            {
              "speaker": "mira",
              "text": "Aksel: Bohrstaub, Marsch, Erinnerungslücke und ungewöhnliche Körpertemperatur."
            }
          ]
        },
        {
          "requires": [
            {
              "state": "thal_returning",
              "operator": "eq",
              "value": true
            }
          ],
          "appendMessages": [
            {
              "speaker": "mira",
              "text": "Ingrid: Unterkühlung und Erschöpfung, aber keine bestätigte Probenexposition."
            }
          ]
        },
        {
          "requires": [
            {
              "state": "kader_escorted_to_lab",
              "operator": "eq",
              "value": true
            }
          ],
          "appendMessages": [
            {
              "speaker": "mira",
              "text": "Kader: direkter Kontakt zur Kernkammer und deutliche Verhaltensänderungen."
            }
          ]
        }
      ],
