      "chapter": 7,
      "delaySeconds": 60,
      "messages": [
        { "speaker": "mira", "text": "Der Notruf braucht einen Bericht. Das Rettungsteam entscheidet danach über Ausrüstung und Quarantäne." }
      ],
      "choices": [
        {
          "id": "full_report",
          "label": "Alles melden, einschließlich eigener möglicher Symptome.",
          "next": "k7_061_report_sent",
          "requires": [],
          "effects": [
            { "state": "report_honesty", "operation": "set", "value": "full" },
            { "state": "trust_mira", "operation": "add", "value": 1 }
          ]
        },
        {
          "id": "partial_report",
          "label": "Bedrohung und Beweise melden, persönliche Symptome auslassen.",
          "next": "k7_061_report_sent",
          "requires": [],
          "effects": [
            { "state": "report_honesty", "operation": "set", "value": "partial" }
          ]
        },
        {
          "id": "false_report",
          "label": "Nur Unfall und Koordinaten melden.",
          "next": "k7_061_report_sent",
          "requires": [],
          "effects": [
