    {
      "id": "k7_010_synthesis",
      "chapter": 7,
      "delaySeconds": 720,
      "messages": [
        { "speaker": "mira", "text": "Der Hemmstoff ist fertig." },
        { "speaker": "mira", "text": "„Gegenmittel“ wäre zu viel gesagt. Er blockiert die Netzstruktur in Zellkulturen." },
        { "speaker": "mira", "text": "Ob er in einem Menschen dasselbe tut, weiß niemand." }
      ],
      "variants": [
        {
          "requires": [
            { "state": "doses_available", "operator": "eq", "value": 0 }
          ],
          "appendMessages": [
            { "speaker": "mira", "text": "Wir haben keine verwendbare Dosis. Nur Rettung und Eindämmung bleiben." }
          ]
        },
        {
          "requires": [
            { "state": "doses_available", "operator": "eq", "value": 1 }
          ],
          "appendMessages": [
            { "speaker": "mira", "text": "Eine Dosis. Nicht genug für alle." }
          ]
        },
        {
          "requires": [
            { "state": "doses_available", "operator": "eq", "value": 2 }
          ],
          "appendMessages": [
            { "speaker": "mira", "text": "Zwei Dosen. Nicht genug für alle erreichbaren Personen." }
          ]
        },
        {
          "requires": [
            { "state": "doses_available", "operator": "eq", "value": 3 }
          ],
          "appendMessages": [
            { "speaker": "mira", "text": "Drei Dosen. Mehr lässt der Ansatz nicht zu." }
          ]
        }
      ],
      "next": "k7_020_candidates",
      "nextDelaySeconds": 60
    },
    {
      "id": "k7_020_candidates",
      "chapter": 7,
      "delaySeconds": 60,
      "messages": [
        { "speaker": "mira", "text": "Bei mir: mögliche Exposition, Erinnerungslücken, veränderte Wahrnehmung. Aber auch Kopfverletzung, Kälte und Erschöpfung." },
        { "speaker": "mira", "text": "Bei Aksel: Bohrstaub, Marsch, Erinnerungslücke, ungewöhnliche Körpertemperatur." },
        { "speaker": "mira", "text": "Bei Thal: eigene Erinnerungslücken und lange Zeit allein. Keine bestätigte Probenexposition." },
        { "speaker": "mira", "text": "Bei Kader: direkter Kontakt zur Kernkammer und verändertes Verhalten." },
        { "speaker": "mira", "text": "Das sind Indizien. Keine Diagnose." }
      ],
      "next": "k7_030_distribution_gate",
      "nextDelaySeconds": 30
    },
