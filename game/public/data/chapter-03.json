    {
      "id": "k3_010_rest",
      "chapter": 3,
      "delaySeconds": 900,
      "messages": [
        {
          "speaker": "mira",
          "text": "Ich bin für ein paar Minuten eingeschlafen. Nicht geplant."
        },
        {
          "speaker": "mira",
          "text": "Das Licht ist noch an. Draußen ist der Wind stärker geworden."
        },
        {
          "speaker": "mira",
          "text": "Aksel sollte im Verbindungsgang sitzen. Er ist nicht mehr da."
        }
      ],
      "variants": [
        {
          "requires": [
            {
              "state": "aksel_restrained",
              "operator": "eq",
              "value": true
            }
          ],
          "appendMessages": [
            {
              "speaker": "mira",
              "text": "Die Gurte liegen auf dem Boden. Nicht zerrissen. Geöffnet."
            }
          ]
        }
      ],
      "next": "k3_020_window",
