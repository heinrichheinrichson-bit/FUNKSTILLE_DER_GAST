      "chapter": 3,
      "delaySeconds": 20,
      "messages": [
        {
          "speaker": "mira",
          "text": "Ich sehe ihn durch das Fenster."
        },
        {
          "speaker": "mira",
          "text": "Aksel geht vom Wohntrakt weg. Er trägt Parka und Maske, aber seine Sicherungsleine hängt lose hinter ihm."
        },
        {
          "speaker": "mira",
          "text": "Er bewegt sich entlang der Masten, ohne sich einzuhaken. Im Whiteout reicht ein Fehltritt, und ich verliere ihn."
        }
      ],
      "variants": [
        {
          "requires": [
            {
              "state": "aksel_restrained",
              "operator": "eq",
              "value": true
            }
          ],
          "prependMessages": [
            {
              "speaker": "mira",
              "text": "Das sieht aus wie Aksel. Aber ich habe ihn selbst eingeschlossen."
            },
            {
              "speaker": "mira",
              "text": "Die Tür war mechanisch verriegelt. Wie ist er nach draußen gekommen?"
            }
          ]
        },
        {
          "requires": [
            {
              "state": "player_name_known",
              "operator": "eq",
              "value": true
            },
            {
              "state": "relay_privacy",
              "operator": "eq",
              "value": "mentioned"
            }
          ],
          "appendMessages": [
            {
              "speaker": "mira",
              "text": "Bevor er ging, hat Aksel gefragt, wer {{player_name}} ist. Ich habe deinen Namen nie laut gesagt."
            }
          ]
        },
        {
          "requires": [
            {
              "state": "player_name_known",
              "operator": "eq",
              "value": true
            },
            {
              "state": "relay_privacy",
              "operator": "eq",
